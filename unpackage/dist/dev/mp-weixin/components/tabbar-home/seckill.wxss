.seckill-box.data-v-601f75ba {
  width: calc(100% - 40rpx);
  padding: 20rpx;
  background-color: #fff;
  border-radius: 20rpx;
}
.seckill-box .seckill-img.data-v-601f75ba {
  background-image: url(data:image/png;base64,);
  background-repeat: no-repeat;
  background-size: 100% 100%;
  width: 124rpx;
  height: 42rpx;
}
.seckill-box .seckill-title.data-v-601f75ba {
  font-size: 22rpx;
  color: #999999;
  position: relative;
  padding-left: 14rpx;
  margin-left: 14rpx;
}
.seckill-box .seckill-title.data-v-601f75ba::before {
  content: "";
  height: 24rpx;
  width: 2rpx;
  position: absolute;
  top: calc(50% - 10rpx);
  left: 0rpx;
  background-color: #bfbfbf;
}
.seckill-box .time-box.data-v-601f75ba {
  display: flex;
  align-items: center;
  /* 关键：子项垂直居中 */
  height: 36rpx;
  line-height: 36rpx;
  margin-top: 2rpx;
}
.seckill-box .time-box .time-item.data-v-601f75ba {
  background-color: #fd8d11;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.seckill-box .time-box .margn-info.data-v-601f75ba {
  margin-left: -10rpx;
}
.seckill-box .time-box .time-doc.data-v-601f75ba {
  color: #fd8d11;
  margin: 0 4rpx;
  margin-top: -6rpx;
}
.seckill-box .scroll-container.data-v-601f75ba {
  width: 100%;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.seckill-box .scroll-container .product-list.data-v-601f75ba {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 20rpx;
  /* 间距 */
  margin-top: 30rpx;
}
.seckill-box .scroll-container .product-list .product-item.data-v-601f75ba {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
