.bg-white {
  background-color: #ffffff;
}
.bg-ccc {
  background-color: #ccc;
}
.bg-f6 {
  background-color: #f6f6f6;
}
.m-b-10 {
  margin-bottom: 20rpx;
}
.m-b-16 {
  margin-bottom: 32rpx;
}
.m-b-20 {
  margin-bottom: 40rpx;
}
.m-b-30 {
  margin-bottom: 50rpx;
}
