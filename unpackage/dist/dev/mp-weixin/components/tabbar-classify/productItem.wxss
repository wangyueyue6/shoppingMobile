}
.padding-around {
  padding: 40rpx;
}
.flex {
  display: flex;
  flex-direction: row;
}
.flex-column {
  flex-direction: column;
}
.flex-one {
  flex: 1;
}
.flex-middle {
  align-items: center;
}
.flex-between {
  justify-content: space-between;
}
.flex-center {
  justify-content: center;
}
.flex-end {
  justify-content: flex-end;
}
.flex-around {
  justify-content: space-around;
}
.center {
  text-align: center;
}
.bold {
  font-weight: bold;
}
.bolder {
  font-weight: bolder;
}
.small {
  font-size: 24rpx;
}
.big {
  font-size: 32rpx;
}
.text-color-info {
  color: #bfbfbf;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.relative {
  position: relative;
}
.absolute {
  position: absolute;
}
.product-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  padding: 10rpx;
  box-sizing: border-box;
}
.product-item .img-box {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 10rpx;
  background-color: #f5f5f5;
  position: relative;
  overflow: hidden;
}
.product-item .img-box .product-image {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}
.product-item .product-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.product-item .product-info {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
}
.product-item .product-info .product-price {
  font-size: 24rpx;
  color: #ff6600;
  font-weight: bold;
}
.product-item .product-info .product-sales {
  font-size: 20rpx;
  color: #999;
}
