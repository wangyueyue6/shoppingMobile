<view data-event-opts="{{[['tap',[['handleClick',['$event']]]]]}}" class="product-item" bindtap="__e"><view class="img-box"><image class="product-image" src="{{product.image}}" mode="aspectFill"></image></view><text class="product-name">{{product.name}}</text><view class="product-info"><text class="product-price">{{"¥"+product.price}}</text><text class="product-sales">{{"销量: "+product.sales}}</text></view></view>